# Backup konteyneri: pg_dump server bilan bir xil versiya (18.6) bo'lishi shart.
FROM postgres:18.6-alpine

RUN apk add --no-cache age bash curl findutils tzdata

ENV TZ=Asia/Tashkent
COPY scripts/backup.sh scripts/restore.sh scripts/restore_test.sh /usr/local/bin/
COPY scripts/backup.crontab /etc/crontabs/root
RUN chmod 0755 /usr/local/bin/backup.sh /usr/local/bin/restore.sh /usr/local/bin/restore_test.sh

# crond oldingi planda; vazifalar chiqishi `docker compose logs backup` da ko'rinadi
CMD ["crond", "-f", "-l", "8"]
