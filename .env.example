# Nusxa oling: cp .env.example .env  — keyin qiymatlarni to'ldiring.
# .env HECH QACHON git'ga qo'shilmaydi. Yo'riqnoma: docs/SETUP_KEYS.md

# --- Muhit ---
# dev | staging | prod
ENVIRONMENT=dev
LOG_LEVEL=INFO
TIMEZONE=Asia/Tashkent

# --- Telegram ---
# @BotFather dan olingan token
BOT_TOKEN=
# Admin(lar) telefon raqami, vergul bilan: +998901234567
# Shu raqam egasi botda raqamini ulashganda admin bo'ladi.
ADMIN_PHONES=
# Zaxira yo'l: admin Telegram ID'si (ixtiyoriy)
ADMIN_TELEGRAM_IDS=

# --- PostgreSQL ---
POSTGRES_USER=nargiza
POSTGRES_PASSWORD=
POSTGRES_DB=nargiza
# Bot shu cheklangan rol bilan ulanadi (migratsiya yaratadi). Parol — kamida 16 belgi.
POSTGRES_APP_USER=nargiza_app
POSTGRES_APP_PASSWORD=
# Docker ichida: postgres. Kompyuterdan to'g'ridan-to'g'ri: localhost
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Faqat dev: kompyuterdagi qaysi portga ochilsin (127.0.0.1 ga bog'langan)
POSTGRES_HOST_PORT=5432

# --- AI ---
# gemini (keyinchalik: claude)
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Model nomi kodda yozilmaydi. 3-bosqichda joriy hujjatdan tanlanadi.
GEMINI_MODEL=gemini-3.5-flash-lite
# Voice messages are off for now (text only). true = understand voice messages
VOICE_ENABLED=false

# --- Feature flaglar ---
ENABLE_CARD_PAYMENTS=false

# --- Backup (1-bosqichda) ---
# age ochiq kaliti (age1...). Yopiq kalit serverda saqlanmaydi!
BACKUP_AGE_RECIPIENT=
BACKUP_DIR=/backups
